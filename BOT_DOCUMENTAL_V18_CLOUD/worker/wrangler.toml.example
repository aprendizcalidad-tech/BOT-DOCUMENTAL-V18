name = "bot-documental-v18-backend"
main = "worker.js"
compatibility_date = "2026-09-01"

[vars]
ALLOWED_ORIGINS = "https://TU-USUARIO.github.io,http://localhost:5500,http://127.0.0.1:5500"

# No pongas GEMINI_API_KEY ni APP_TOKEN aquí si publicas el repositorio.
# Agrégalos como Secrets desde Cloudflare Dashboard -> Workers & Pages -> Settings -> Variables and Secrets.
