name = "bot-documental-v19-1-backend"
main = "worker.js"
compatibility_date = "2026-09-01"

[vars]
ALLOWED_ORIGINS = "https://TU-USUARIO.github.io,http://localhost:5500,http://127.0.0.1:5500"
B2_BUCKET_ID = "TU_BUCKET_ID"
B2_BUCKET_NAME = "bot-documental-v19-videos"
GROQ_MODEL = "openai/gpt-oss-120b"
GROQ_FALLBACK_MODEL = "openai/gpt-oss-20b"
DEEPGRAM_MODEL = "nova-3"

# Secrets (NO publicarlos en GitHub):
# GROQ_API_KEY
# DEEPGRAM_API_KEY
# B2_APPLICATION_KEY_ID
# B2_APPLICATION_KEY
# MEDIA_SIGNING_SECRET
# APP_TOKEN
#
# V19.1 NO usa R2 y NO necesita ningún binding VIDEO_BUCKET.
